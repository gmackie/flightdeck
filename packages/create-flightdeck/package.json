{
  "name": "create-flightdeck",
  "version": "0.0.0",
  "description": "Register apps with a self-hosted Flightdeck and (later) install it.",
  "type": "module",
  "bin": {
    "create-flightdeck": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/cli.js --banner:js='#!/usr/bin/env node'",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2"
  }
}
