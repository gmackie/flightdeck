{
  "name": "@flightdeckhq/schema",
  "version": "0.1.1",
  "description": "Shared event schema, validation and route normalization for Flightdeck.",
  "keywords": [
    "flightdeck",
    "analytics",
    "product-analytics",
    "cloudflare",
    "schema",
    "valibot"
  ],
  "homepage": "https://github.com/gmackie/flightdeck/tree/main/packages/schema#readme",
  "bugs": {
    "url": "https://github.com/gmackie/flightdeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmackie/flightdeck.git",
    "directory": "packages/schema"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
