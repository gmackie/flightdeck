{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flightdeck-lifecycle-outbox-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  // Flightdeck must grant this app lifecycle.write (docs/operations/lifecycle-ingestion.md).
  "services": [
    {
      "binding": "FLIGHTDECK",
      "service": "flightdeck",
      "entrypoint": "Ingest",
      "props": { "appId": "app_deploys" }
    }
  ],
  // Local-only example database; create your own with `wrangler d1 create` before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifecycle-outbox-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Drains the outbox every minute.
  "triggers": { "crons": ["* * * * *"] }
}
