{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flightdeck-lifecycle-review.schema.json",
  "title": "Independent review record that a set of findings is resolved on one commit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "commit",
    "reviewedAt",
    "reviewer",
    "independent",
    "synthetic",
    "findings"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "flightdeck-lifecycle-review" },
    "version": { "const": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
    },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 80 },
    "independent": { "type": "boolean" },
    "synthetic": { "type": "boolean" },
    "findings": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$" },
      "additionalProperties": { "enum": ["resolved", "open", "unclear"] }
    },
    "notes": { "type": "string", "maxLength": 2000 }
  }
}
