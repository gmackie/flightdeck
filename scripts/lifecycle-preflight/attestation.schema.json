{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flightdeck-lifecycle-attestation.schema.json",
  "title": "Operator attestation for one live release gate (no secrets, no personal data)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "gate",
    "environment",
    "commit",
    "verifiedAt",
    "verifiedBy",
    "method",
    "synthetic",
    "checks"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "flightdeck-lifecycle-attestation" },
    "version": { "const": 1 },
    "gate": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "environment": { "enum": ["staging", "production"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "verifiedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
    },
    "verifiedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
    "method": { "type": "string", "minLength": 10, "maxLength": 1000 },
    "synthetic": { "type": "boolean" },
    "engine": { "type": "string", "minLength": 1, "maxLength": 80 },
    "checks": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
      "additionalProperties": { "type": "boolean" }
    },
    "references": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 300 }
    }
  }
}
