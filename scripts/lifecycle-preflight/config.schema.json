{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flightdeck-lifecycle-preflight-config.schema.json",
  "title": "Flightdeck lifecycle preflight input (intended staging settings; never secrets)",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "environment"],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "flightdeck-lifecycle-preflight-config" },
    "version": { "const": 1 },
    "environment": { "enum": ["synthetic", "staging"] },
    "description": { "type": "string", "maxLength": 300 },
    "hostnames": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "dashboard": { "$ref": "#/$defs/host" }, "mcp": { "$ref": "#/$defs/host" } }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "teamDomain": { "$ref": "#/$defs/host" },
        "dashboardAud": { "$ref": "#/$defs/aud" },
        "mcpAud": { "$ref": "#/$defs/aud" }
      }
    },
    "flags": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" }
    },
    "services": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding", "service", "entrypoint"],
        "properties": {
          "binding": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "service": { "type": "string", "pattern": "^[a-z0-9-]{1,63}$" },
          "entrypoint": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$" }
        }
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protectedResourceMetadata"],
      "properties": { "protectedResourceMetadata": { "$ref": "#/$defs/repoPath" } }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "days": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perPrincipalDailyQueries", "perAppDailyQueries", "maxRowsPerQuery"],
      "properties": {
        "perPrincipalDailyQueries": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "perAppDailyQueries": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "maxRowsPerQuery": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "minCohort": { "type": "integer", "minimum": 0, "maximum": 1000 } }
    },
    "attestations": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/repoPath" }
    }
  },
  "$defs": {
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
    },
    "aud": { "type": "string", "pattern": "^([0-9a-f]{64}|synthetic-[a-z0-9-]{1,48})$" },
    "repoPath": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$"
    }
  }
}
