{
  "name": "flightdeck",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^26.13.1",
    "pnpm": "^12.21.0"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --project lifecycle-mcp --project flightdeck-mcp-live apps/lifecycle-mcp/test/acceptance.test.ts apps/lifecycle-mcp/test/investigation-engine.test.ts apps/flightdeck/test/lifecycle-mcp-live.test.ts",
    "build": "pnpm -r build",
    "smoke:pack": "bash scripts/pack-smoke.sh",
    "release:version": "node scripts/release-version.mjs",
    "format:check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
