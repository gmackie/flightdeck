{
  "name": "flightdeck",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "setup": "node scripts/setup.mjs",
    "setup:console": "node scripts/setup-console.mjs",
    "doctor": "node scripts/doctor.mjs",
    "source:add": "node scripts/source.mjs",
    "source:govern": "node scripts/source-governance.mjs",
    "test:govern": "node --test scripts/source-governance.test.mjs",
    "workspace:deploy": "node scripts/workspace-deploy.mjs",
    "workspace:backup": "node scripts/backup.mjs",
    "workspace:restore": "node scripts/restore.mjs",
    "workspace:doctor": "node scripts/doctor-remote.mjs",
    "test:integration": "vitest run tests/integration",
    "test:deployment": "node --test scripts/workspace-deploy.test.mjs",
    "wizard": "node scripts/wizard.mjs",
    "test:wizard": "node --test scripts/wizard.test.mjs",
    "access:provision": "node scripts/access-provision.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.47.0"
  }
}
