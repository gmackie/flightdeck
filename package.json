{
  "name": "flightdeck",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --project lifecycle-mcp --project flightdeck-mcp-live apps/lifecycle-mcp/test/acceptance.test.ts apps/lifecycle-mcp/test/investigation-engine.test.ts apps/flightdeck/test/lifecycle-mcp-live.test.ts",
    "build": "pnpm -r build",
    "smoke:pack": "bash scripts/pack-smoke.sh",
    "release:version": "node scripts/release-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
