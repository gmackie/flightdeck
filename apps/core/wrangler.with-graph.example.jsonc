{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flightdeck-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "vars": {
    "SINK_MODE": "r2"
  },
  "r2_buckets": [
    {
      "binding": "EVENTS",
      "bucket_name": "flightdeck-events"
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "META",
      "database_name": "flightdeck-meta",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_UUID",
      "migrations_dir": "../../migrations"
    }
  ]
}
