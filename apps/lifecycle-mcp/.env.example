# Local `wrangler dev` overrides for the lifecycle MCP server. Copy to `.env` (git-ignored).
# Nothing here is a secret: Access team domains and AUD tags are identifiers, and this server
# holds no API keys. Never put an Access service token's client secret in this file.

# development | staging | production. production is refused by this build (src/config.ts).
LIFECYCLE_MCP_ENVIRONMENT=development

# disabled | synthetic | read-api. read-api fails closed until the Workstream H adapter lands.
LIFECYCLE_MCP_SOURCE=synthetic

# Leave both empty only for local synthetic development together with LIFECYCLE_MCP_DEV=1.
# Otherwise: your team (e.g. acme.cloudflareaccess.com) and the AUD tag of the Access
# application that protects the MCP hostname (not the dashboard's).
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Local-only Access bypass; honoured only with development + synthetic + empty Access settings.
LIFECYCLE_MCP_DEV=1

# Minimum distinct cases per released group. Values below 5 are raised to 5.
LIFECYCLE_MCP_MIN_COHORT=5

# Comma-separated browser origins allowed to call /mcp; empty allows none (non-browser clients
# send no Origin header).
LIFECYCLE_MCP_ALLOWED_ORIGINS=
