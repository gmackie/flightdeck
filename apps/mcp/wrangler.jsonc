{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flightdeck-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "CONSOLE",
      "service": "flightdeck-console"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "",
    "ENABLE_ADMIN_MCP_WRITES": "false"
  },
  "observability": {
    "enabled": true
  }
}
