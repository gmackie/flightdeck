{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flightdeck",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  // The dashboard SPA (apps/dashboard); `pnpm run dev` and `pnpm run ship` build it first.
  "assets": {
    "directory": "../dashboard/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_fd/*", "/v1/*", "/healthz", "/__dev/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "APP", "class_name": "AppDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO", "AppDO"] }],
  // Retries lifecycle projection and Basin forwarding (src/lifecycle-projection/schedule.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flightdeck",
      "database_id": "fa1402e6-0f7a-4ba0-ba1b-348d0dee8ae1",
      "migrations_dir": "migrations"
    }
  ],
  "pipelines": [
    { "binding": "EVENTS", "stream": "ff8610cd69224104bafad28a00accabd" },
    { "binding": "SESSIONS", "stream": "a8da4675e9bc42bf838cf3fc2b8fd947" }
    // Opt-in lifecycle stream (docs/operations/lifecycle-ingestion.md). Until it is bound,
    // accepted lifecycle writes remain in the D1 outbox for forwarding. Provision it with
    // `scripts/provision-dev.sh --lifecycle`, then add a comma above and this entry with the
    // printed fd_lifecycle_events stream id:
    // { "binding": "LIFECYCLE_EVENTS", "stream": "<fd_lifecycle_events stream id>" }
  ],
  // Cloudflare Access must protect every hostname that serves the dashboard and /api/*,
  // including the workers.dev one; otherwise disable workers_dev and use a custom domain.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    // The dashboard's Access application audience (AUD tag); /api/* requires it.
    "ACCESS_AUD": "",
    // Private MCP RPC is opt-in; its audience MUST differ from the dashboard audience.
    "LIFECYCLE_MCP_READ_ENABLED": "0",
    "LIFECYCLE_MCP_ACCESS_AUD": "",
    // Guard is optional to install; aggregate reads are denied until explicitly enforced.
    // LIFECYCLE_PRIVACY_KEY is a separate stable HMAC secret (>=32 chars), never a var.
    "LIFECYCLE_PRIVACY_MODE": "disabled",
    "LIFECYCLE_PRIVACY_RESTRICTED": "deny",
    // Explicit compatibility rollout for live/live/ws/trends only. Lifecycle always requires grants.
    // Apply 0010 + provision grants, then set to "enforce". Unknown values fail closed.
    "READ_AUTHZ_MODE": "legacy",
    // This Worker's name, echoed in the service bindings /api/apps hands out.
    "FLIGHTDECK_WORKER_NAME": "flightdeck",
    "FLIGHTDECK_DEV": "0"
  }
}
