{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flightdeck",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "APP", "class_name": "AppDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO", "AppDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flightdeck",
      "database_id": "fa1402e6-0f7a-4ba0-ba1b-348d0dee8ae1",
      "migrations_dir": "migrations"
    }
  ],
  "pipelines": [
    { "binding": "EVENTS", "stream": "ff8610cd69224104bafad28a00accabd" },
    { "binding": "SESSIONS", "stream": "a8da4675e9bc42bf838cf3fc2b8fd947" }
  ],
  "vars": { "ACCESS_TEAM_DOMAIN": "", "FLIGHTDECK_DEV": "0" }
}
