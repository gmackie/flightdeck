{
  "name": "@flightdeckhq/app",
  "private": true,
  "type": "module",
  "scripts": {
    "build:dashboard": "pnpm --filter @flightdeckhq/dashboard build",
    "dev": "pnpm build:dashboard && wrangler dev",
    "ship": "pnpm build:dashboard && wrangler deploy",
    "typecheck": "wrangler types --strict-vars false && tsc -p ."
  },
  "dependencies": {
    "@flightdeckhq/schema": "workspace:*",
    "@flightdeckhq/worker": "workspace:*",
    "jose": "^6.2.14",
    "ulid": "^3.0.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "wrangler": "^4.156.0"
  }
}
